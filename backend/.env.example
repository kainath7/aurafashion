# Aura Fashion Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Configuration
# Username: shoppeaurafashion_db_user
# Cluster: ac-ugxck16-shard-00
# Auth Database: admin
MONGO_URI=mongodb+srv://shoppeaurafashion_db_user:<YOUR_PASSWORD>@ac-ugxck16-shard-00.mongodb.net/aura_fashion?authSource=admin&retryWrites=true&w=majority

# Local Development Fallback URI (if offline)
# MONGO_URI=mongodb://127.0.0.1:27017/aura_fashion

# JWT Secret Key
JWT_SECRET=aura_fashion_super_secret_jwt_key_2026_secure

# Razorpay Payment Gateway (Test / Live Credentials)
RAZORPAY_KEY_ID=rzp_test_AURAFASHION123
RAZORPAY_KEY_SECRET=aura_test_secret_key_placeholder

# Cloudinary Cloud Photography Storage
CLOUDINARY_CLOUD_NAME=aura-fashion
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Business Email (Brevo / Sendinblue or Gmail App Password)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=c1d3d3001@smtp-brevo.com
EMAIL_PASS=your_smtp_key_here
EMAIL_FROM=Aura Fashion <shoppe.aurafashion@gmail.com>
ADMIN_EMAIL=shoppe.aurafashion@gmail.com

# Client Applications for CORS
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
